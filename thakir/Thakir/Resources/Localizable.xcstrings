      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose from Photos"
          }
        }
      }
    },
    "لصق نص": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste text"
          }
        }
      }
    },
    "هذا الجهاز لا يدعم التعرّف على النص العربي في الصور. يمكنك لصق النص مباشرة.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device cannot recognize Arabic text in images. You can paste text directly."
          }
        }
      }
    },
    "لصق النص": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste Text"
          }
        }
      }
    },
