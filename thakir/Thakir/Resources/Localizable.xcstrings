    },
    "ذاكِر يحوّل صفحات الكتب إلى بطاقات مراجعة، ويجدولها بخوارزمية التكرار المتباعد لتذكّرها لفترة أطول. كل بياناتك تبقى على جهازك.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thakir turns textbook pages into flashcards and schedules them with spaced repetition so you remember longer. All your data stays on your device."
          }
        }
      }
    },
